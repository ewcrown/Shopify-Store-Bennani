<section class="ew-meet-founders-section">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="ew-founders__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    
    <div class="ew-founders__grid">
      {% for block in section.blocks %}
        <div class="ew-founder__card" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <div class="ew-founder__image-wrapper">
              <img 
                src="{{ block.settings.image | img_url: '600x600' }}" 
                alt="{{ block.settings.name | default: 'Founder' }}"
                class="ew-founder__image"
                loading="lazy"
                width="600"
                height="600"
              />
            </div>
          {% endif %}
          
          <div class="ew-founder__content">
            {% if block.settings.name != blank %}
              <h3 class="ew-founder__name">{{ block.settings.name }}</h3>
            {% endif %}
            
            {% if block.settings.title != blank %}
              <p class="ew-founder__title">{{ block.settings.title }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .ew-meet-founders-section {
    padding: 80px 0;
    background-color: #fff;
    font-family: 'Josefin Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .ew-founders__heading {
    font-size: 14px;
    font-weight: 700;
    color: #1a1a1a;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-align: center;
    margin: 0 0 80px 0;
  }

  .ew-founders__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
    max-width: 900px;
    margin: 0 auto;
  }

  .ew-founder__card {
    display: flex;
    flex-direction: column;
  }

  .ew-founder__image-wrapper {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    margin-bottom: 20px;
  }

  .ew-founder__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ew-founder__content {
    text-align: left;
  }

  .ew-founder__name {
    font-size: 14px;
    font-weight: 700;
    color: #000;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .ew-founder__title {
    font-size: 12px;
    font-weight: 400;
    color: #000;
    margin: 0;
    line-height: 1.5;
    letter-spacing:0;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .ew-meet-founders-section {
      padding: 60px 0;
    }
    
    .ew-founders__heading {
      margin-bottom: 50px;
    }
    
    .ew-founders__grid {
      gap: 30px;
    }
  }

  @media (max-width: 768px) {
    .ew-meet-founders-section {
      padding: 40px 0;
    }
    
    .ew-founders__heading {
      margin-bottom: 40px;
    }
    
    .ew-founders__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    
    .ew-founder__image-wrapper {
      margin-bottom: 16px;
    }
  }

  @media (max-width: 480px) {
    .ew-meet-founders-section {
      padding: 30px 0;
    }
    
    .ew-founders__heading {
      margin-bottom: 30px;
    }
    
    .ew-founders__grid {
      gap: 30px;
    }
  }
</style>

{% schema %}
{
  "name": "EW Meet the Founders",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "MEET THE FOUNDERS"
    }
  ],
  "blocks": [
    {
      "type": "founder",
      "name": "Founder",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "FOUNDER NAME"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Bennani Co-founder and Co-Chief Executive Officer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EW Meet the Founders",
      "blocks": [
        {
          "type": "founder",
          "settings": {
            "name": "WAEL NABBOUT",
            "title": "Bennani Co-founder and Co-Chief Executive Officer"
          }
        },
        {
          "type": "founder",
          "settings": {
            "name": "EMIL CELIKOVIC",
            "title": "Bennani Co-founder and Co-Chief Executive Officer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
