<!-- Load Splide CSS and JS if not already loaded -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.3/dist/css/splide.min.css">
<script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.3/dist/js/splide.min.js" defer></script>

<section id="ew-journey-{{ section.id }}" class="ew-journey-section">
  <div class="container">
    <div class="ew-journey__header">
      <h2 class="ew-journey__title">{{ section.settings.title }}</h2>
      <div class="ew-journey__controls">
        <button class="ew-journey__arrow ew-journey__arrow--prev" aria-label="Previous">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="ew-journey__arrow ew-journey__arrow--next" aria-label="Next">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="ew-journey__slider splide" id="ew-journey-splide-{{ section.id }}">
      <div class="splide__track">
        <ul class="splide__list">
          {% for block in section.blocks %}
            <li class="splide__slide ew-journey__slide" {{ block.shopify_attributes }}>
              <div class="ew-journey__item">
                {% if block.settings.video_url != blank %}
                  <!-- Video takes priority -->
                  <div class="ew-journey__video-wrapper">
                    <video 
                      class="ew-journey__video"
                      poster="{% if block.settings.image %}{{ block.settings.image | img_url: '600x400' }}{% endif %}"
                      preload="metadata"
                      muted
                      loop
                      autoplay
                    >
                      <source src="{{ block.settings.video_url.sources[1].url }}" type="video/mp4">
                      Your browser does not support the video tag.
                    </video>
                    <div class="ew-journey__play-button" data-video-url="{{ block.settings.video_url }}">
                      <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
                        <circle cx="30" cy="30" r="30" fill="rgba(0,0,0,0.7)"/>
                        <path d="M22 18L22 42L42 30L22 18Z" fill="white"/>
                      </svg>
                    </div>
                  </div>
                {% elsif block.settings.image %}
                  <!-- Fallback to image if no video -->
                  <div class="ew-journey__image-wrapper">
                    <img 
                      src="{{ block.settings.image | img_url: '600x400' }}" 
                      alt="{{ block.settings.image.alt | default: 'Journey Image' }}"
                      class="ew-journey__image"
                      loading="lazy"
                      sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 25vw"
                      srcset="{{ block.settings.image | img_url: '300x200' }} 300w,
                              {{ block.settings.image | img_url: '600x400' }} 600w,
                              {{ block.settings.image | img_url: '900x600' }} 900w"
                    />
                  </div>
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .ew-journey-section {
    padding: 120px 0;
    background-color: #f8f9fa;
    font-family: 'Josefin Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .ew-journey__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
  }

  .ew-journey__title {
    font-size: 18px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .ew-journey__controls {
    display: flex;
    gap: 10px;
  }

  .ew-journey__arrow {
    width: 35px;
    height: 35px;
    border: none;
    background: transparent;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    opacity: 0.6;
    border: 1px solid;
  }

  .ew-journey__arrow:hover {
    opacity: 1;
    background: rgba(0, 0, 0, 0.05);
  }

  .ew-journey__arrow svg {
    color: #666;
    width: 16px;
    height: 16px;
}

  .ew-journey__slider {
    width: 100%;
  }

  .ew-journey__slide {
    padding: 0 10px;
  }

  .ew-journey__item {
    background: transparent;
    border-radius: 0;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .ew-journey__item:hover {
    transform: scale(1.02);
  }

  .ew-journey__image-wrapper,
  .ew-journey__video-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ew-journey__image,
  .ew-journey__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ew-journey__item:hover .ew-journey__image,
  .ew-journey__item:hover .ew-journey__video {
    transform: scale(1.05);
  }

  .ew-journey__play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
    transition: transform 0.3s ease;
    opacity: 0.9;
  }

  .ew-journey__play-button:hover {
    transform: translate(-50%, -50%) scale(1.1);
    opacity: 1;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .ew-journey-section {
      padding: 60px 0;
    }
    
    .ew-journey__header {
      margin-bottom: 30px;
    }
  }

  @media (max-width: 768px) {
    .ew-journey-section {
      padding: 40px 0;
    }
    
    .ew-journey__container {
      padding: 0 15px;
    }
    
    .ew-journey__header {
      flex-direction: column;
      gap: 20px;
      text-align: center;
    }
    .ew-journey__slide {
      padding: 0 5px;
    }
  }

</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    function init() {
      var splideEl = document.getElementById('ew-journey-splide-{{ section.id }}');
      if (!splideEl) return;
      if (typeof Splide === 'undefined') return setTimeout(init, 120);

      var splide = new Splide(splideEl, {
        type: 'loop',
        perPage: 4,
        perMove: 1,
        gap: '20px',
        pagination: false,
        arrows: false,
        autoplay: false,
        breakpoints: {
          1200: { perPage: 3, gap: '15px' },
          900: { perPage: 2, gap: '15px' },
          600: { perPage: 1, gap: '10px' }
        }
      });
      
      splide.mount();
      
      // Custom arrow controls
      var prevArrow = document.querySelector('.ew-journey__arrow--prev');
      var nextArrow = document.querySelector('.ew-journey__arrow--next');
      
      if (prevArrow) {
        prevArrow.addEventListener('click', function() {
          splide.go('<');
        });
      }
      
      if (nextArrow) {
        nextArrow.addEventListener('click', function() {
          splide.go('>');
        });
      }
      
      // Video play functionality
      var playButtons = document.querySelectorAll('.ew-journey__play-button');
      playButtons.forEach(function(button) {
        button.addEventListener('click', function() {
          var slide = this.closest('.ew-journey__slide');
          var video = slide.querySelector('.ew-journey__video');
          
          if (video) {
            video.play();
            this.style.display = 'none';
            
            video.addEventListener('ended', function() {
              button.style.display = 'flex';
            });
          }
        });
      });
    }
    init();
  });
</script>

{% schema %}
{
  "name": "EW Journey Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "OUR JOURNEY"
    }
  ],
  "blocks": [
    {
      "type": "journey_item",
      "name": "Journey Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video_url",
          "label": "Video (optional)",
          "info": "Add a video to show a play button overlay"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EW Journey Section",
      "blocks": [
        {
          "type": "journey_item"
        },
        {
          "type": "journey_item"
        },
        {
          "type": "journey_item"
        },
        {
          "type": "journey_item"
        }
      ]
    }
  ]
}
{% endschema %}
