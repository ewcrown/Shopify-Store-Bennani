          }
        },
        {
          "type": "content",
          "settings": {
            "content": "<h2>Last updated on September, 2020</h2><p>Welcome to our website. These Terms of Use apply to all visitors, users, and others who access this Website. By accessing or using the Website, you agree to be bound by these Terms of Use.</p><h2>Acceptance of Terms</h2><p>Please read these Terms of Use carefully before you start to use this Website. If you do not agree to these Terms of Use, you must not access or use this Site.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
