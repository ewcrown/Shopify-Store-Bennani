<section class="ew-faq-section">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="ew-faq__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    
    <div class="ew-faq__cards">
      {% for block in section.blocks %}
        <div class="ew-faq__card" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <div class="ew-faq__image-wrapper">
              <img 
                src="{{ block.settings.image | img_url: '800x1000' }}" 
                alt="{{ block.settings.alt_text | default: 'FAQ card' }}"
                class="ew-faq__image"
                loading="lazy"
                width="800"
                height="1000"
              />
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .ew-faq-section {
    padding: 100px 0;
    font-family: 'Josefin Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ew-faq__heading {
    font-size: 42px;
    font-weight: 700;
    color: #1a1a1a;
    text-align: center;
    margin: 0 0 30px 0;
    text-transform: none;
    line-height: normal;
  }

  .ew-faq__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    align-items: start;
  }

  .ew-faq__card {
    position: relative;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
  }

  .ew-faq__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    border-radius: 2px;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .ew-faq-section {
      padding: 80px 0;
    }
    
    .ew-faq__heading {
      font-size: 42px;
      margin-bottom: 60px;
    }
    
    .ew-faq__cards {
      gap: 30px;
    }
  }

  @media (max-width: 768px) {
    .ew-faq-section {
      padding: 60px 0;
    }
    
    .ew-faq__heading {
      font-size: 36px;
      margin-bottom: 50px;
    }
    
    .ew-faq__cards {
      grid-template-columns: 1fr;
      gap: 50px;
      max-width: 400px;
      margin: 0 auto;
    }
  }

  @media (max-width: 480px) {
    .ew-faq-section {
      padding: 40px 0;
    }
    
    .ew-faq__heading {
      font-size: 28px;
      margin-bottom: 40px;
    }
    
    .ew-faq__cards {
      gap: 40px;
    }
  }
</style>

{% schema %}
{
  "name": "EW FAQ Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ"
    }
  ],
  "blocks": [
    {
      "type": "faq_card",
      "name": "FAQ Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image",
          "info": "Upload an image of the paper card with FAQ content"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "default": "FAQ card"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EW FAQ Section",
      "blocks": [
        {
          "type": "faq_card"
        },
        {
          "type": "faq_card"
        },
        {
          "type": "faq_card"
        }
      ]
    }
  ]
}
{% endschema %}
