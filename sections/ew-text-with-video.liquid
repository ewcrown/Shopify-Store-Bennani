{%- comment -%}
  sections/ew-media-text.liquid
  - Left: text (title + rich text)
  - Right: media area (video OR image). Video has priority over image.
  - Fix: properly handle 'video' setting that may be an object (VideoDrop / .url / .sources)
  - Provide responsive aspect-ratio support (CSS aspect-ratio with padding-top fallback)
{%- endcomment -%}

<section id="ew-media-text-{{ section.id }}" class="ew-media-text-section" role="region" aria-labelledby="ew-media-text-title-{{ section.id }}">
  <div class="container ew-media-text__wrap">
    <div class="ew-media-text__inner">

      <!-- Left: Text -->
      <div class="ew-media-text__col ew-media-text__col--left">
        {% if section.settings.title != blank %}
          <h2 id="ew-media-text-title-{{ section.id }}" class="ew-media-text__title">{{ section.settings.title }}</h2>
        {% endif %}

        {% if section.settings.content != blank %}
          <div class="ew-media-text__content rte">
            {{ section.settings.content }}
          </div>
        {% endif %}
      </div>

      <!-- Right: Media (video priority) -->
      <div class="ew-media-text__col ew-media-text__col--right" aria-live="polite">

        {%- comment -%}
          Normalize video input:
            - Accepts VideoDrop object, VideoDrop.sources array, or plain string URL
            - Attempt to find a usable URL from the setting
        {%- endcomment -%}
        {%- assign raw_video = section.settings.video_url -%}

        {%- comment -%}
          Try common shapes:
          - If raw_video is an object with .url -> use it
          - If raw_video has .sources (array) -> use first source.url
          - Else assume it's a string
        {%- endcomment -%}
        {%- assign video_url = "" -%}
        {%- if raw_video != blank and raw_video != nil -%}
          {%- comment -%}VideoDrop with url{%- endcomment -%}
          {%- if raw_video.url != blank and raw_video.url != nil -%}
            {%- assign video_url = raw_video.url -%}
          {%- elsif raw_video.sources != blank and raw_video.sources != nil -%}
            {%- if raw_video.sources.size > 0 and raw_video.sources[1].url != blank -%}
              {%- assign video_url = raw_video.sources[1].url -%}
            {%- endif -%}
          {%- else -%}
            {%- assign video_url = raw_video | default: "" -%}
          {%- endif -%}
        {%- endif -%}

        {%- assign image_obj = section.settings.image -%}
        {%- assign image_alt = section.settings.image_alt | default: section.settings.title -%}

        {%- comment -%}
          Decide which media to render:
          1) If video_url present -> show video (iframe for YouTube/Vimeo or <video> for direct URL)
          2) Else if image uploaded -> show image
          3) Else show placeholder
        {%- endcomment -%}

        {% if video_url != blank %}
          <div class="ew-media-text__media ew-media-text__media--video" data-src="{{ video_url }}">
            {%- comment -%}
              If URL looks like YouTube or Vimeo -> embed as iframe
              Else assume direct video file -> use <video>
            {%- endcomment -%}

            {%- assign vid = video_url | downcase -%}
            {% if vid contains 'youtube.com' or vid contains 'youtu.be' or vid contains 'vimeo.com' %}
              <div class="ew-media-text__iframe-wrap" role="group" aria-label="Embedded video">
                <iframe
                  class="ew-media-text__iframe"
                  src="{{ video_url | replace: 'watch?v=', 'embed/' }}"
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  title="{{ section.settings.title | default: 'Video' | escape }}"></iframe>
              </div>

            {% else %}
              <div class="ew-media-text__video-wrap" role="group" aria-label="Video">
                <video
                  class="ew-media-text__video"
                  src="{{ video_url }}"
                  controls
                  muted
                  autoplay
                  playsinline
                  preload="metadata"
                  {% if section.settings.autoplay == true %} autoplay muted loop {% endif %}>
                  Sorry, your browser doesn't support embedded videos.
                </video>
              </div>
            {% endif %}
          </div>

        {% elsif image_obj != blank %}
          <div class="ew-media-text__media ew-media-text__media--image">
            <div class="ew-media-text__image-wrap">
              <img class="ew-media-text__image" src="{{ image_obj | img_url: 'master' }}" alt="{{ image_alt | escape }}" />
            </div>
          </div>

        {% else %}
          <div class="ew-media-text__media ew-media-text__media--placeholder">
            <div class="ew-media-text__placeholder">Add a video URL or upload an image in the section settings.</div>
          </div>
        {% endif %}
      </div>

    </div>
  </div>

  <!-- Styles (no settings for CSS; all styling kept internal) -->
  <style>
    /* Layout */
    #ew-media-text-{{ section.id }} { padding: 48px 0; }
    #ew-media-text-{{ section.id }} .ew-media-text__inner {
      display: grid;
      grid-template-columns: repeat(2,1fr);
      gap: 32px;
      align-items: center;
    }

    /* Left column (text) */
    .ew-media-text__col--left { padding: 0 12px; }
    .ew-media-text__title { 
      font-size: 28px;
      font-weight:400;
      line-height: normal;
      text-transform:uppercase;
      text-align:center;
    }
    .ew-media-text__content { font-size: 16px; color: #222; line-height: 1.6; }

    /* Right column (media) */
    .ew-media-text__col--right { display:flex; align-items:center; justify-content:center; }
    .ew-media-text__media { width:100%; max-width: 100%; }

    /*
      Responsive aspect-ratio wrappers:
      - Prefer CSS aspect-ratio (modern browsers)
      - Provide padding-top fallback for older browsers
      - Default ratio: 16 / 9 (can be changed by editing --media-aspect-ratio)
    */
    .ew-media-text__iframe-wrap,
    .ew-media-text__video-wrap,
    .ew-media-text__image-wrap {
      --media-aspect-ratio: calc(16 / 9);
      position: relative;
      width: 100%;
      overflow: hidden;
      border-radius: 2px;
      box-shadow: 0 6px 24px rgba(11, 37, 51, 0.06);
      background: #000;
      padding-top: 120%;
    }

    /* Make embedded elements fill wrapper */
    .ew-media-text__iframe,
    .ew-media-text__video,
    .ew-media-text__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }

    .ew-media-text__video,
    .ew-media-text__image {
      object-fit: cover; /* cover fills whole area while preserving aspect */
      background: #000;
    }

    /* If you want to preserve the full video frame (no cropping), change object-fit to 'contain' */
    /* .ew-media-text__video, .ew-media-text__image { object-fit: contain; background: #000; } */

    .ew-media-text__placeholder {
      width: 100%;
      height: 320px;
      display:flex;
      align-items:center;
      justify-content:center;
      color:#777;
      background:#f3f3f3;
      border-radius: 2px;
      padding: 18px;
      text-align:center;
    }

    /* Responsive */
    @media (max-width: 960px) {
      #ew-media-text-{{ section.id }} .ew-media-text__inner {
        grid-template-columns: 1fr;
      }
      .ew-media-text__col--left { order: 1; margin-top: 24px; }
      .ew-media-text__col--right { order: 0; }
      /* make media slightly taller on small screens */
      .ew-media-text__iframe-wrap,
      .ew-media-text__video-wrap,
      .ew-media-text__image-wrap {
        padding-top: 120%; /* fallback for narrow viewport */
      }
    }
  </style>

</section>

{%- schema -%}
{
  "name": "Media + Text",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "BENNANI presets initils"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content (left side)"
    },
    {
      "type": "video",
      "id": "video_url",
      "label": "Video URL (YouTube/Vimeo or direct video file URL)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image (used if no video URL provided)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay direct video files (muted + loop)",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Media + Text",
      "category": "Text"
    }
  ]
}
{%- endschema -%}