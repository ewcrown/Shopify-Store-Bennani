<section id="ew-model-slider-{{ section.id }}" class="ew-model-slider-section">
  <div class="ew-model-slider__inner-wrap">
    <div class="container">
      <div class="ew-model-slider__inner">

        <!-- Model Image -->
        <div class="ew-model-slider__model-wrap">
          {%- assign first_product = collections[section.settings.collection].products.first -%}
          {%- assign initial_model_img = section.settings.model_image | default: "" -%}
          {%- if initial_model_img == "" and first_product != blank -%}
            {%- assign pm = first_product.metafields.custom.model_image -%}
            {%- if pm != blank %}
              {%- assign initial_model_img = pm | img_url: 'master' -%}
            {%- endif -%}
          {%- endif -%}

          <div class="ew-model-slider__model">
            {% if initial_model_img != blank %}
              <img id="ew-model-image-{{ section.id }}" src="{{ initial_model_img | img_url: 'master' }}" alt="Model" />
            {% else %}
              <div id="ew-model-image-{{ section.id }}" class="ew-model-slider__model-placeholder">Model image not set</div>
            {% endif %}
          </div>
        </div>

        <!-- Product Slider -->
        <div class="ew-model-slider__slider-wrap">
          <h3 class="ew-model-slider__title">Shop the Look</h3>

          <div id="ew-splide-{{ section.id }}" class="splide ew-splide">
            <div class="splide__track">
              <ul class="splide__list">
                {%- assign coll = collections[section.settings.collection] -%}
                {%- if coll and coll.products_count > 0 -%}
                  {%- for product in coll.products limit: section.settings.limit -%}
                    {%- assign model_img = product.metafields.custom.model_image -%}
                    {%- assign model_img_url = model_img | default: '' | img_url: 'master' -%}

                    <li class="splide__slide ew-model-slide"
                        data-model-image="{{ model_img_url }}"
                        data-product-url="{{ product.url }}"
                        tabindex="0">
                      <a class="ew-model-slide__inner" href="javascript:void(0)" aria-label="Select {{ product.title }}">
                        <div class="ew-model-slide__figure">
                          {% if product.featured_image %}
                            <img src="{{ product.featured_image | img_url: '480x480' }}" alt="{{ product.title }}" />
                          {% else %}
                            <div style="height:200px;width:100%;display:flex;align-items:center;justify-content:center;color:#999;">No image</div>
                          {% endif %}
                        </div>
                        <div class="ew-model-slide__meta">
                          <div class="ew-model-slide__title">{{ product.title }}</div>
                        </div>
                      </a>
                    </li>
                  {%- endfor -%}
                {%- else -%}
                  <li class="splide__slide">No products found in collection.</li>
                {%- endif -%}
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <style>
    .ew-model-slider-section {
      font-family: 'Josefin Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .ew-model-slider__inner {
      display: flex;
      gap: 40px;
      align-items: flex-start;
    }

    .ew-model-slider__model-wrap {
      flex: 1;
      max-width: 35%;
    }

    .ew-model-slider__model {
      width: 100%;
      aspect-ratio: 3/4;
      overflow: hidden;
    }

    .ew-model-slider__model img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: opacity 0.3s ease;
    }

    .ew-model-slider__model-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #666;
      font-size: 16px;
    }

    .ew-model-slider__slider-wrap {
      flex: 1;
      max-width: 65%;
    }

    .ew-model-slider__title {
      font-size: 28px;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 30px;
      text-align: center;
    }

    .ew-splide {
      width: 100%;
    }

    .ew-model-slide {
      padding: 0 12px;
    }

    .ew-model-slide__inner {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    .ew-model-slide__figure {
      width: 100%;
      aspect-ratio: 1;
      overflow: hidden;
      margin-bottom: 15px;
    }

    .ew-model-slide__figure img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .ew-model-slide__meta {
      text-align: center;
    }

    .ew-model-slide__title {
      font-size: 16px;
      font-weight: 500;
      color: #1a1a1a;
      line-height: 1.4;
    }

    /* Clean Arrow Styling */
    .splide__arrow {
      background: transparent;
      border: none;
      width: 50px;
      height: 50px;
      opacity: 0.6;
      transition: opacity 0.3s ease;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 10;
    }

    .splide__arrow:hover {
      opacity: 1;
      background: transparent;
      transform: translateY(-50%);
    }

    .splide__arrow svg {
      fill: #666;
      width: 24px;
      height: 24px;
      stroke-width: 1;
    }

    .splide__arrow--prev {
      left: -15px;
    }

    .splide__arrow--next {
      right: -15px;
    }

    /* Responsive Design */
    @media (max-width: 1024px) {
      .ew-model-slider__inner {
        gap: 30px;
      }
      
      .ew-model-slider__title {
        font-size: 24px;
        margin-bottom: 25px;
      }
    }

    @media (max-width: 768px) {
      .ew-model-slider-section {
        padding: 40px 0;
      }
      
      .ew-model-slider__inner {
        flex-direction: column;
        gap: 30px;
      }
      
      .ew-model-slider__model-wrap {
        max-width: 100%;
        order: 2;
      }
      
      .ew-model-slider__slider-wrap {
        max-width: 100%;
        order: 1;
        padding: 0px;
      }
      
      .ew-model-slider__title {
        font-size: 22px;
        margin-bottom: 20px;
      }
      
      .ew-model-slider__model {
        aspect-ratio: 4/5;
        margin-bottom: 0px;
      }
    }

    @media (max-width: 480px) {
      .ew-model-slider-section {
        padding: 30px 0;
      }
      
      .ew-model-slider__inner {
        gap: 20px;
      }
      
      .ew-model-slider__title {
        font-size: 20px;
        margin-bottom: 15px;
      }
      
      .ew-model-slide {
        padding: 0 8px;
      }
      
      .splide__arrow {
        width: 50px;
        height: 50px;
      }
      
      .splide__arrow svg {
        width: 24px;
        height: 24px;
        stroke-width: 1;
      }
      
      .splide__arrow--prev {
        left: -10px;
      }

      .splide__arrow--next {
        right: -10px;
      }
    }

    @media (max-width: 360px) {
      .ew-model-slider__title {
        font-size: 18px;
      }
      
      .ew-model-slide__title {
        font-size: 14px;
      }
      
      .splide__arrow {
        width: 50px;
        height: 50px;
      }
      
      .splide__arrow svg {
        width: 24px;
        height: 24px;
        stroke-width: 1;
      }
      
      .splide__arrow--prev {
        left: -8px;
      }

      .splide__arrow--next {
        right: -8px;
      }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      function init() {
        var splideEl = document.getElementById('ew-splide-{{ section.id }}');
        if (!splideEl) return;
        if (typeof Splide === 'undefined') return setTimeout(init, 120);

        var splide = new Splide(splideEl, {
          perPage: 2,
          perMove: 1,
          gap: '24px',
          pagination: false,
          arrows: true,
          breakpoints: { 
            1024: { perPage: 2, gap: '20px' },
            768: { perPage: 1, gap: '16px' },
            480: { perPage: 1, gap: '12px' }
          },
        });
        splide.mount();

        var slides = splideEl.querySelectorAll('.ew-model-slide');
        var modelImageEl = document.getElementById('ew-model-image-{{ section.id }}');

        function setModelImage(url) {
          if (!modelImageEl || !url) return;
          if (modelImageEl.tagName.toLowerCase() === 'img') {
            modelImageEl.style.opacity = 0;
            setTimeout(() => {
              modelImageEl.src = url;
              modelImageEl.style.opacity = 1;
            }, 200);
          } else {
            const wrapper = modelImageEl.parentNode;
            const img = document.createElement('img');
            img.id = modelImageEl.id;
            img.src = url;
            img.alt = 'Model';
            img.style.opacity = 0;
            wrapper.replaceChild(img, modelImageEl);
            modelImageEl = img;
            setTimeout(() => img.style.opacity = 1, 40);
          }
        }

        // Change model image when active slide changes
        splide.on('moved', function (newIndex) {
          const activeSlide = slides[newIndex];
          if (activeSlide) {
            const newImage = activeSlide.getAttribute('data-model-image');
            if (newImage) setModelImage(newImage);
          }
        });

        // Also change on first mount (initial active)
        splide.on('mounted', function () {
          const activeSlide = slides[splide.index];
          if (activeSlide) {
            const newImage = activeSlide.getAttribute('data-model-image');
            if (newImage) setModelImage(newImage);
          }
        });

        // Optional manual click override
        slides.forEach(slide => {
          slide.addEventListener('click', evt => {
            evt.preventDefault();
            const modelUrl = slide.getAttribute('data-model-image');
            if (modelUrl) setModelImage(modelUrl);
          });

          slide.addEventListener('keydown', evt => {
            if (evt.key === 'Enter') {
              const modelUrl = slide.getAttribute('data-model-image');
              if (modelUrl) setModelImage(modelUrl);
            }
          });
        });
      }
      init();
    });
  </script>
</section>

{%- schema -%}
{
  "name": "EW Model + Product Slider",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection to show in slider" },
    { "type": "number", "id": "limit", "label": "Number of products to show" },
    { "type": "image_picker", "id": "model_image", "label": "Fallback model image (optional)" }
  ],
  "presets": [
    { "name": "EW Model + Product Slider", "category": "Product" }
  ]
}
{%- endschema -%}