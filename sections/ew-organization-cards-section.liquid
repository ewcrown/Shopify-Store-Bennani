<section class="ew-organization-cards-section">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="ew-organization__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    
    <div class="ew-organization__grid">
      {% for block in section.blocks %}
        <div class="ew-organization__card" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <div class="ew-organization__image-wrapper">
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'ew-organization__image', width: 400, height: 300 }}
            </div>
          {% endif %}
          
          <div class="ew-organization__content">
            {% if block.settings.title != blank %}
              <h3 class="ew-organization__title">{{ block.settings.title }}</h3>
            {% endif %}
            
            {% if block.settings.description != blank %}
              <p class="ew-organization__description">{{ block.settings.description }}</p>
            {% endif %}
            
            {% if block.settings.button_text != blank %}
              <div class="ew-organization__button-wrapper">
                <a href="{{ block.settings.button_link | default: '#' }}" class="ew-organization__button button color-scheme--{{ section.settings.button_scheme | default: 'scheme-4' }}">
                  {{ block.settings.button_text }}
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .ew-organization-cards-section {
    padding: 80px 0;
    background-color: #fff;
    font-family: 'Josefin Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .ew-organization__button-wrapper {
  text-align: center;
}

.ew-organization__button {
  padding: 12px 32px;
  line-height: normal;
  font-size:12px;
}

  .ew-organization__heading {
    font-size: 20px;
    font-weight: 700;
    color: #1a1a1a;
    text-align: left;
    margin: 0 0 20px 0;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.2;
}

  .ew-organization__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .ew-organization__card {
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ew-organization__image-wrapper {
    width: 100%;
    height: 250px;
    overflow: hidden;
  }

  .ew-organization__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .ew-organization__card:hover .ew-organization__image {
    transform: scale(1.05);
  }

  .ew-organization__content {
    padding: 10px 0 0;
  }

  .ew-organization__title {
    font-size: 18px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 5px 0;
    line-height: 1.3;
    text-transform: none;
    letter-spacing: 0;
}

.ew-organization__description {
  font-size: 14px;
  font-weight: 400;
  color: #000;
  margin: 0 0 25px 0;
  line-height: 1.6;
  letter-spacing: 0;
  font-style: italic;
}


  /* Responsive Design */
  @media (max-width: 1024px) {
    .ew-organization-cards-section {
      padding: 60px 0;
    }
    
    .ew-organization__heading {
      font-size: 32px;
      margin-bottom: 50px;
    }
    
    .ew-organization__grid {
      gap: 30px;
    }
    
    .ew-organization__content {
      padding: 25px 20px;
    }
  }

  @media (max-width: 768px) {
    .ew-organization-cards-section {
      padding: 50px 0;
    }
    
    .ew-organization__heading {
      font-size: 28px;
      margin-bottom: 40px;
    }
    
    .ew-organization__grid {
      grid-template-columns: 1fr;
      gap: 30px;
      max-width: 500px;
    }
    
    .ew-organization__image-wrapper {
      height: 200px;
    }
    
    .ew-organization__content {
      padding: 20px;
    }
    
    .ew-organization__title {
      font-size: 18px;
    }
    
    .ew-organization__description {
      font-size: 15px;
    }
  }

  @media (max-width: 480px) {
    .ew-organization-cards-section {
      padding: 40px 0;
    }
    
    .ew-organization__heading {
      font-size: 24px;
      margin-bottom: 30px;
    }
    
    .ew-organization__grid {
      gap: 25px;
    }
    
    .ew-organization__content {
      padding: 15px;
    }
    
    .ew-organization__title {
      font-size: 16px;
      margin-bottom: 12px;
    }
    
    .ew-organization__description {
      font-size: 14px;
      margin-bottom: 20px;
    }
    
    .ew-organization__button {
      padding: 10px 20px;
      font-size: 13px;
    }
  }
</style>

{% schema %}
{
  "name": "EW Organization Cards",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How your making a change"
    },
    {
      "type": "select",
      "id": "button_scheme",
      "label": "Button Color Scheme",
      "options": [
        {
          "value": "scheme-1",
          "label": "Scheme 1"
        },
        {
          "value": "scheme-2",
          "label": "Scheme 2"
        },
        {
          "value": "scheme-3",
          "label": "Scheme 3"
        },
        {
          "value": "scheme-4",
          "label": "Scheme 4"
        }
      ],
      "default": "scheme-4"
    }
  ],
  "blocks": [
    {
      "type": "organization_card",
      "name": "Organization Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Organization Title",
          "default": "Organization Name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Brief description of the organization and their mission."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "LEARN MORE"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link",
          "info": "Link for the button"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EW Organization Cards",
      "blocks": [
        {
          "type": "organization_card",
          "settings": {
            "title": "charity water",
            "description": "Bring clean and safe water to every person on the planet",
            "button_text": "LEARN MORE"
          }
        },
        {
          "type": "organization_card",
          "settings": {
            "title": "SOS Children's Villages",
            "description": "1 in 10 children and young people are separated from their families, abandoned, neglected",
            "button_text": "LEARN MORE"
          }
        },
        {
          "type": "organization_card",
          "settings": {
            "title": "The Fred Hollows Foundation",
            "description": "Fred Hollows is remembered for the incredible legacy he left behind",
            "button_text": "LEARN MORE"
          }
        }
      ]
    }
  ]
}
{% endschema %}
