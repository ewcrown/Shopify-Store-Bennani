<section class="ew-impact-grid-section">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="ew-impact__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="ew-impact__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="ew-impact__grid">
      <div class="ew-impact__column">
        {% for block in section.blocks limit: 4 %}
          <a href="{{ block.settings.link | default: '#' }}" class="ew-impact__item" {{ block.shopify_attributes }}>
            {% if block.settings.image %}
              <div class="ew-impact__image-wrapper">
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', class: 'ew-impact__image', width: 600, height: 600
                }}
              </div>
            {% endif %}
          </a>
        {% endfor %}
      </div>

      <div class="ew-impact__column">
        {% for block in section.blocks offset: 4 limit: 4 %}
          <a href="{{ block.settings.link | default: '#' }}" class="ew-impact__item" {{ block.shopify_attributes }}>
            {% if block.settings.image %}
              <div class="ew-impact__image-wrapper">
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', class: 'ew-impact__image', width: 600, height: 600
                }}
              </div>
            {% endif %}
          </a>
        {% endfor %}
      </div>

      <div class="ew-impact__column">
        {% for block in section.blocks offset: 8 limit: 4 %}
          <a href="{{ block.settings.link | default: '#' }}" class="ew-impact__item" {{ block.shopify_attributes }}>
            {% if block.settings.image %}
              <div class="ew-impact__image-wrapper">
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', class: 'ew-impact__image', width: 600, height: 600
                }}
              </div>
            {% endif %}
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  .ew-impact-grid-section {
    padding: 60px 0;
    background-color: #fff;
    font-family: 'Josefin Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ew-impact__heading {
    font-size: 20px;
    font-weight: 700;
    color: #1a1a1a;
    text-align: center;
    margin: 0 0 10px 0;
    letter-spacing: 0;
    text-transform: none;
    line-height: normal;
  }

  .ew-impact__subheading {
    letter-spacing: 0;
    font-size: 12px;
    font-weight: 400;
    color: #000;
    text-align: center;
    margin: 0 0 80px 0;
    max-width: 476px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
    font-style: italic;
  }

  .ew-impact__grid {
    display: flex;
    gap: 30px;
  }

  .ew-impact__column {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 30px;
  }

  .ew-impact__item {
    display: block;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  /* First wrapper specific positioning */
  .ew-impact__column:first-child .ew-impact__item:nth-child(1) {
    grid-column: 1 / 3; /* Spans columns 1-2 */
    grid-row: 1;
  }

  .ew-impact__column:first-child .ew-impact__item:nth-child(2) {
    grid-column: 3 / 7; /* Spans columns 3-6 */
    grid-row: 1;
  }

  .ew-impact__column:first-child .ew-impact__item:nth-child(3) {
    grid-column: 1 / 4; /* Spans columns 1-3 */
    grid-row: 2;
  }

  .ew-impact__column:first-child .ew-impact__item:nth-child(4) {
    grid-column: 4 / 7; /* Spans columns 4-6 */
    grid-row: 2;
  }

  /* Second wrapper specific positioning */

  .ew-impact__column:nth-child(2) .ew-impact__item:nth-child(1) {
    grid-column: 1 / 4;
    grid-row: 1;
  }

  .ew-impact__column:nth-child(2) .ew-impact__item:nth-child(2) {
    grid-column: 4 / 7;
    grid-row: 1;
  }

  .ew-impact__column:nth-child(2) .ew-impact__item:nth-child(3) {
    grid-column: 1 / 5;
    grid-row: 2;
  }

  .ew-impact__column:nth-child(2) .ew-impact__item:nth-child(4) {
    grid-column: 5 / 7;
    grid-row: 2;
  }

  .ew-impact__column:nth-child(3) .ew-impact__item:nth-child(2),
  .ew-impact__column:nth-child(3) .ew-impact__item:nth-child(1),
  .ew-impact__column:nth-child(2) .ew-impact__item:nth-child(3),
  .ew-impact__column:nth-child(2) .ew-impact__item:nth-child(4),
  .ew-impact__column:first-child .ew-impact__item:nth-child(1),
  .ew-impact__column:first-child .ew-impact__item:nth-child(2) {
    height: 150px;
  }

  .ew-impact__column:nth-child(3) .ew-impact__item:nth-child(3),
  .ew-impact__column:nth-child(3) .ew-impact__item:nth-child(4),
  .ew-impact__column:nth-child(2) .ew-impact__item:nth-child(2),
  .ew-impact__column:nth-child(2) .ew-impact__item:nth-child(1),
  .ew-impact__column:first-child .ew-impact__item:nth-child(3),
  .ew-impact__column:first-child .ew-impact__item:nth-child(4) {
    height: 250px;
  }

  /* Third wrapper specific positioning (same as first wrapper) */
  .ew-impact__column:nth-child(3) .ew-impact__item:nth-child(1) {
    grid-column: 1 / 3; /* Spans columns 1-2 */
    grid-row: 1;
  }

  .ew-impact__column:nth-child(3) .ew-impact__item:nth-child(2) {
    grid-column: 3 / 7; /* Spans columns 3-6 */
    grid-row: 1;
  }

  .ew-impact__column:nth-child(3) .ew-impact__item:nth-child(3) {
    grid-column: 1 / 4; /* Spans columns 1-3 */
    grid-row: 2;
  }

  .ew-impact__column:nth-child(3) .ew-impact__item:nth-child(4) {
    grid-column: 4 / 7; /* Spans columns 4-6 */
    grid-row: 2;
  }

  .ew-impact__item:hover {
    transform: scale(1.05);
  }

  .ew-impact__image-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
    background-color: #f0f0f0;
  }

  .ew-impact__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.3s ease;
    border-radius: 0;
    box-shadow: none;
  }

  .ew-impact__item:hover .ew-impact__image {
    transform: scale(1.1);
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .ew-impact__grid {
      gap: 20px;
    }

    .ew-impact__column {
      gap: 20px;
    }
  }

  @media (max-width: 1024px) {
    .ew-impact-grid-section {
      padding: 50px 0;
    }

    .ew-impact__subheading {
      margin-bottom: 50px;
    }

    .ew-impact__grid {
      gap: 15px;
    }

    .ew-impact__column {
      gap: 15px;
    }
  }

  @media (max-width: 768px) {
    .ew-impact-grid-section {
      padding: 40px 0;
    }

    .ew-impact__heading {
      font-size: 28px;
    }

    .ew-impact__subheading {
      font-size: 16px;
      margin-bottom: 40px;
    }

    .ew-impact__grid {
      flex-direction: column;
      gap: 10px;
    }

    .ew-impact__column {
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }

    /* Reset specific positioning for tablet */
    .ew-impact__column:first-child .ew-impact__item:nth-child(1),
    .ew-impact__column:first-child .ew-impact__item:nth-child(2),
    .ew-impact__column:first-child .ew-impact__item:nth-child(3),
    .ew-impact__column:first-child .ew-impact__item:nth-child(4),
    .ew-impact__column:nth-child(2) .ew-impact__item:nth-child(1),
    .ew-impact__column:nth-child(2) .ew-impact__item:nth-child(2),
    .ew-impact__column:nth-child(2) .ew-impact__item:nth-child(3),
    .ew-impact__column:nth-child(2) .ew-impact__item:nth-child(4),
    .ew-impact__column:nth-child(3) .ew-impact__item:nth-child(1),
    .ew-impact__column:nth-child(3) .ew-impact__item:nth-child(2),
    .ew-impact__column:nth-child(3) .ew-impact__item:nth-child(3),
    .ew-impact__column:nth-child(3) .ew-impact__item:nth-child(4) {
      grid-column: auto;
      grid-row: auto;
    }
  }

  @media (max-width: 600px) {
    .ew-impact__grid {
      gap: 8px;
    }

    .ew-impact__column {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
  }

  @media (max-width: 480px) {
    .ew-impact-grid-section {
      padding: 30px 0;
    }

    .ew-impact__heading {
      font-size: 24px;
    }

    .ew-impact__subheading {
      font-size: 14px;
      margin-bottom: 30px;
    }

    .ew-impact__grid {
      gap: 5px;
    }

    .ew-impact__column {
      grid-template-columns: repeat(2, 1fr);
      gap: 5px;
    }
  }

  @media (max-width: 360px) {
    .ew-impact__grid {
      gap: 3px;
    }

    .ew-impact__column {
      gap: 3px;
    }
  }
</style>

