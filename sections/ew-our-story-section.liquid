<section class="ew-about-us-section">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="ew-about__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    
    {% if section.settings.subheading != blank %}
      <p class="ew-about__subheading">{{ section.settings.subheading }}</p>
    {% endif %}
    
    <div class="ew-about__images">
      {% for block in section.blocks %}
        <div class="ew-about__image-block" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <div class="ew-about__image-wrapper">
              <img 
                src="{{ block.settings.image | img_url: '1200x1200' }}" 
                alt="{{ block.settings.alt_text | default: 'Bennani notebook' }}"
                class="ew-about__image"
                loading="lazy"
                width="1200"
                height="1200"
              />
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .ew-about-us-section {
    padding: 100px 0;
    background-color: #fff;
    font-family: 'Josefin Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }


  .ew-about__heading {
    font-size: 16px;
    font-weight: 700;
    color: #1a1a1a;
    text-align: center;
    line-height: normal;
    margin: 0 0 24px 0;
    text-transform: none;
  }

  .ew-about__subheading {
    font-size: 14px;
    color: #000;
    text-align: center;
    margin: 0 0 60px 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    letter-spacing:0;
  }

  .ew-about__images {
    display: flex;
    flex-direction: column;
    gap: 60px;
    align-items: center;
  }

  .ew-about__image-block {
    width: 100%;
    max-width: 800px;
  }

  .ew-about__image-wrapper {
    width: 100%;
    overflow: hidden;
  }

  .ew-about__image {
    display: block;
    object-fit: contain;
    height: 26rem;
}

  /* Responsive Design */
  @media (max-width: 1024px) {
    .ew-about-us-section {
      padding: 80px 0;
    }
    
    
    .ew-about__subheading {
      font-size: 15px;
      margin-bottom: 60px;
    }
    
    .ew-about__images {
      gap: 50px;
    }
  }

  @media (max-width: 768px) {
    .ew-about-us-section {
      padding: 60px 0;
    }
    
    .ew-about__heading {
      margin-bottom: 20px;
    }
    
    .ew-about__subheading {
      font-size: 14px;
      margin-bottom: 50px;
    }
    
    .ew-about__images {
      gap: 40px;
    }
    .ew-about__image {
      height: 16rem;
    }
  }

  @media (max-width: 480px) {
    .ew-about-us-section {
      padding: 40px 0;
    }
    
    .ew-about__heading {
      margin-bottom: 16px;
    }
    
    .ew-about__subheading {
      font-size: 13px;
      margin-bottom: 40px;
    }
    
    .ew-about__images {
      gap: 32px;
    }
  }
</style>

{% schema %}
{
  "name": "EW About Us",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WE ARE BENNANI"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "this is the part where we tell you more about us"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Notebook Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "default": "Bennani notebook"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EW About Us",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
