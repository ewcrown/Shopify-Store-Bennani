{% if template.name != 'index' %}
<style>
  #shopify-section-{{ section.id }} .custom-footer {
    background: #051f38;
    padding: 35px 0;
    color: #ffffff;
    position: relative;
  }

  #shopify-section-{{ section.id }} .custom-footer-logo {
    display: flex;
    justify-content: flex-end;
  }
  
  #shopify-section-{{ section.id }} .custom-footer-logo img {
    width: 100px;
  }

  #shopify-section-{{ section.id }} .custom-footer-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: flex-end;
  }

  #shopify-section-{{ section.id }} .custom-footer-left {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  #shopify-section-{{ section.id }} .custom-footer-club-title {
    font-size: 1.2rem;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  #shopify-section-{{ section.id }} .custom-footer-email-label {
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  #shopify-section-{{ section.id }} .custom-footer-email-form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid #ffffff;
    padding-bottom: 0.5rem;
    max-width: 300px;
  }

  #shopify-section-{{ section.id }} .custom-footer-email-input {
    flex: 1;
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 1rem;
    outline: none;
  }

  #shopify-section-{{ section.id }} .custom-footer-email-input::placeholder {
    color: #fff;
  }

  #shopify-section-{{ section.id }} .custom-footer-email-submit {
    background: transparent;
    border: none;
    color: #ffffff;
    cursor: pointer;
    font-size: 1.2rem;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .custom-footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 1rem;
    justify-content: flex-end;
  }

  #shopify-section-{{ section.id }} .custom-footer-nav a {
    color: #ffffff;
    text-decoration: none;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    transition: opacity 0.3s ease;
  }

  #shopify-section-{{ section.id }} .custom-footer-nav a:hover {
    opacity: 0.7;
  }

  #shopify-section-{{ section.id }} .custom-footer-bottom {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .custom-footer-payment-icons {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .custom-footer-payment-icons svg {
    height: 30px;
    width: auto;
  }

  #shopify-section-{{ section.id }} .custom-footer-copyright {
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .custom-footer-email-form {
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .custom-footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    #shopify-section-{{ section.id }} .custom-footer-logo {
      top: 1rem;
      right: 1rem;
      width: 60px;
      height: 60px;
    }

    #shopify-section-{{ section.id }} .custom-footer-nav {
      flex-direction: column;
      gap: 1rem;
    }

    #shopify-section-{{ section.id }} .custom-footer-bottom {
      justify-content: center;
      text-align: center;
    }
  }
</style>

<div class="custom-footer">

  <div class="container custom-footer-content">
    <div class="custom-footer-left">
      <div>
        <h3 class="custom-footer-club-title">BENNANI MEMBERS CLUB</h3>
        {% comment %} <div class="custom-footer-email-label">EMAIL ADDRESS</div> {% endcomment %}
        
        {%- assign newsletter_form_id = 'custom-newsletter-form-' | append: section.id -%}
        {%- form 'customer', id: newsletter_form_id, class: 'custom-footer-email-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input 
            type="email" 
            name="contact[email]" 
            class="custom-footer-email-input" 
            placeholder="EMAIL ADDRESS"
            required
          >
          <button type="submit" class="custom-footer-email-submit">
            →
          </button>
        {%- endform -%}
      </div>
    </div>

    <div class="custom-footer-right">
      {%- if section.settings.logo_image != blank -%}
        <div class="custom-footer-logo">
          <a href="{{ routes.root_url }}">
            {{ section.settings.logo_image | image_url: width: 160 | image_tag: loading: 'lazy' }}
          </a>
        </div>
      {%- endif -%}
      <nav class="custom-footer-nav">
        <a href="{{ routes.account_url }}">YOUR ACCOUNT</a>
        <a href="{{ routes.root_url }}">UNITED KINGDOM (GBP £)</a>
        {%- if section.settings.legal_link != blank -%}
          <a href="{{ section.settings.legal_link }}">LEGAL NOTICE</a>
        {%- endif -%}
        {%- if section.settings.contact_link != blank -%}
          <a href="{{ section.settings.contact_link }}">CONTACT</a>
        {%- endif -%}
      </nav>

      <div class="custom-footer-bottom">
        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <div class="custom-footer-payment-icons">
            {%- for type in shop.enabled_payment_types -%}
              {{- type | payment_type_svg_tag -}}
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div class="custom-footer-copyright">© BENNANI LTD</div>
      </div>
    </div>
  </div>
</div>

{% endif %}

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section--footer",
  "tag": "footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Footer Logo",
      "info": "Circular logo displayed in the top right corner"
    },
    {
      "type": "url",
      "id": "legal_link",
      "label": "Legal Notice Link"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact Link"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    }
  ]
}
{% endschema %}