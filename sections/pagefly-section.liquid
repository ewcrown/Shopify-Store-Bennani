{% if section.settings.section_id.size > 0 %}
  <!-- PageFlyGlobalSection -->
  {% render 'pagefly-main-js' %}
  {% render 'pagefly-main-css' %}
  <div style="position: relative; z-index: 333;">
    {% include section.settings.section_id %}
  </div>
{% else %}
  
  {% if request.design_mode %}
    <style>
      .pf-ph {
        font-size: 14px !important;
        background: #fafafa;
        padding: 20px;
        text-align: center;
        border: 1px solid #f0f0f0;
        border-radius: 4px;
        margin: 15px;
        position: relative;
        z-index: 333;
      }
      .pf-ph span {
        display: block;
        background: #e6f7ff;
        padding: 8px 15px;
        border: 1px solid #91d5ff;
      }
    </style>
    <div class="pf-ph">
      <h3>PageFly Section</h3>
      <span>No section selected. Please select your section from the list</span>
    </div>
  {% endif %}
  
{% endif %}

{% schema %}
{
  "name": "PageFly Section",
  "settings": [
    {
      "id": "section_id",
      "type": "select",
      "label": "Sections",
      "options": [
        {
          "label": "Select section",
          "value": ""
        },
        {
          "label": "Collection Initials",
          "value": "pf-3c8616b9"
        },
        {
          "label": "About Bennani Section",
          "value": "pf-1b1c4598"
      
        },
        {
          "label": "Product Section Block",
          "value": "pf-d5ee4998"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": "Find and edit your section on the [section listing](https://7a7207-a3.myshopify.com/admin/apps/pagefly/sections)"
    },
    {
      "type": "paragraph",
      "content": "To add block to a section, please use the App Block element on PageFly section editor."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "PageFly Section"
    }
  ]
}
{% endschema %}
