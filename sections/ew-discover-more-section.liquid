{% schema %}
{
  "name": "Discover More Section",
  "settings": [
    {
      "type": "text",
      "id": "ew_main_title",
      "label": "Main Title",
      "default": "Discover More"
    },
    {
      "type": "select",
      "id": "button_scheme",
      "label": "Button Color Scheme",
      "options": [
        {
          "value": "scheme-1",
          "label": "Scheme 1"
        },
        {
          "value": "scheme-2",
          "label": "Scheme 2"
        },
        {
          "value": "scheme-3",
          "label": "Scheme 3"
        },
        {
          "value": "scheme-4",
          "label": "Scheme 4"
        }
      ],
      "default": "scheme-4"
    },
    {
      "type": "text",
      "id": "ew_subtitle",
      "label": "Subtitle",
      "default": "Sit Down Relax and Enjoy"
    },
    {
      "type": "text",
      "id": "ew_top_number_1",
      "label": "Top Number 1",
      "default": "20"
    },
    {
      "type": "text",
      "id": "ew_top_number_2",
      "label": "Top Number 2",
      "default": "25"
    },
    {
      "type": "header",
      "content": "Block 1 - Our Story"
    },
    {
      "type": "image_picker",
      "id": "ew_block1_image",
      "label": "Block 1 Image"
    },
    {
      "type": "text",
      "id": "ew_block1_title",
      "label": "Block 1 Button Text",
      "default": "OUR STORY"
    },
    {
      "type": "url",
      "id": "ew_block1_link",
      "label": "Block 1 Link"
    },
    {
      "type": "header",
      "content": "Block 2 - Foundation"
    },
    {
      "type": "image_picker",
      "id": "ew_block2_image",
      "label": "Block 2 Image"
    },
    {
      "type": "text",
      "id": "ew_block2_title",
      "label": "Block 2 Button Text",
      "default": "FOUNDATION"
    },
    {
      "type": "url",
      "id": "ew_block2_link",
      "label": "Block 2 Link"
    },
    {
      "type": "header",
      "content": "Block 3 - Social Media"
    },
    {
      "type": "image_picker",
      "id": "ew_block3_image",
      "label": "Block 3 Image"
    },
    {
      "type": "text",
      "id": "ew_block3_title",
      "label": "Block 3 Button Text",
      "default": "SOCIAL MEDIA"
    },
    {
      "type": "url",
      "id": "ew_block3_link",
      "label": "Block 3 Link"
    },
    {
      "type": "header",
      "content": "Block 4 - Delivery"
    },
    {
      "type": "image_picker",
      "id": "ew_block4_image",
      "label": "Block 4 Image"
    },
    {
      "type": "text",
      "id": "ew_block4_title",
      "label": "Block 4 Button Text",
      "default": "DELIVERY"
    },
    {
      "type": "url",
      "id": "ew_block4_link",
      "label": "Block 4 Link"
    }
  ],
  "presets": [
    {
      "name": "Discover More Section"
    }
  ]
}
{% endschema %}

<div class="ew-discover-more-section">
  <div class="container">
    <!-- Header Section -->
    <div class="ew-header-section">
      <div class="ew-main-title">{{ section.settings.ew_main_title }}</div>
      <div class="ew-subtitle">{{ section.settings.ew_subtitle }}</div>
      <div class="ew-top-numbers">
        <div class="ew-number-1">{{ section.settings.ew_top_number_1 }}</div>
        <div class="ew-number-2">{{ section.settings.ew_top_number_2 }}</div>
      </div>
      <div class="ew-arrows">
        {% for i in (1..4) %}
          {% assign arrow_url = 'https://cdn.shopify.com/s/files/1/0865/6850/1592/files/arrow-' | append: i | append: '.png?v=176134927' | append: i %}
          <img src="{{ arrow_url }}" alt="Arrow {{ i }}" class="ew-arrow ew-arrow-{{ i }}">
        {% endfor %}
      </div>
    </div>

    <!-- Content Blocks -->
    <div class="ew-content-blocks">
      {% for i in (1..4) %}
        {% assign image_setting = 'ew_block' | append: i | append: '_image' %}
        {% assign title_setting = 'ew_block' | append: i | append: '_title' %}
        {% assign link_setting = 'ew_block' | append: i | append: '_link' %}
        
        <a href="{{ section.settings[link_setting] }}" class="ew-block ew-block-{{ i }}" {% if section.settings[image_setting] %}style="background-image: url('{{ section.settings[image_setting] | img_url: '400x400' }}');"{% endif %}>
          <div class="ew-block-button button color-scheme--{{ section.settings.button_scheme | default: 'scheme-4' }}">{{ section.settings[title_setting] }}</div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

<style>
.ew-discover-more-section {
  background-color: #f5f5f5;
  padding: 120px 0;
  font-family: var(--josefin-sans-family);
  width: 100%;
  overflow-x: hidden;
}

.ew-header-section {
  text-align: center;
  margin-bottom: 40px;
  position: relative;
}

.ew-main-title {
  font-size: 24px;
  font-weight: 700 !important;
  color: #031f38;
  margin-bottom: 10px;
  font-family: 'Josefin Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  line-height: normal;
}

.ew-subtitle {
  font-size: 20px;
  color: #031f38;
  margin-bottom: 30px;
  font-weight: 400;
  font-family: 'Josefin Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.ew-top-numbers {
  position: absolute;
  top: -35px;
  right: 0;
  text-align: right;
}

.ew-number-1,
.ew-number-2 {
  font-size: 35px;
  font-weight: 600;
  line-height: normal;
  color: #1a1a1a;
  display: block;
  font-family: 'Josefin Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.ew-arrows {
  display: flex;
  justify-content: space-around;
  margin-top: 20px;
  padding: 0 20px;
}

.ew-arrow {
  width: 100px;
  height: 100px;
  object-fit: contain;
}

.ew-content-blocks {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: 1fr;
  gap: 30px;
  width: 100%;
  max-width: 100%;
}

.ew-block {
  background: #1a1a1a;
  padding: 20px;
  text-align: center;
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  padding-top: 120%;
  text-decoration: none;
  color: inherit;
  transition: all 0.3s ease;
  cursor: pointer;
}

.ew-block:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

/* Button Styles - Using theme's button system */
.ew-block-button {
  /* All styling handled by theme's button system */
  position: relative;
  z-index: 2;
  width: max-content;
  margin: 0 auto;
}

/* Responsive Design */
/* Large tablets and small desktops */
@media (max-width: 1024px) {
  .ew-content-blocks {
    gap: 20px;
  }
  
  .ew-main-title {
    font-size: 42px;
  }
  
  .ew-subtitle {
    font-size: 20px;
  }
}

/* Tablets */
@media (max-width: 768px) {
  .ew-discover-more-section {
    padding: 40px 0;
  }
  
  .ew-content-blocks {
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 15px;
  }
  
  .ew-main-title {
    font-size: 36px;
    margin-bottom: 8px;
  }
  
  .ew-subtitle {
    font-size: 18px;
    margin-bottom: 25px;
  }
  
  .ew-top-numbers {
    position: static;
    text-align: center;
    margin-bottom: 20px;
    display: flex;
    justify-content: center;
  }
  
  .ew-media-text__title {
    font-size: 20px;
}

  .ew-number-1,
  .ew-number-2 {
    display: inline-block;
    margin: 0;
  }
  
  .ew-arrows {
    margin-top: 15px;
    padding: 0 10px;
  }
  
  .ew-arrow {
    width: 25px;
    height: 25px;
  }
  
  .ew-block {
    padding: 15px;
    padding-top: 100%;
  }
  
  .ew-block-button {
    padding: 6px 30px;
    font-size: 13px;
  }
  .ew-arrows {
    display: none;
  }
}

/* Mobile landscape */
@media (max-width: 640px) {
  .ew-content-blocks {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  
  .ew-block {
    padding: 12px;
    padding-top: 120%;
  }
  
  .ew-main-title {
    font-size: 32px;
  }
  
  .ew-subtitle {
    font-size: 16px;
  }
}

/* Mobile portrait */
@media (max-width: 480px) {
  .ew-discover-more-section {
    padding: 30px 0;
  }
  
  .ew-content-blocks {
    grid-template-columns: 1fr;
    grid-template-rows: repeat(4, 1fr);
    gap: 15px;
  }
  
  .ew-main-title {
    font-size: 16px;
    margin-bottom: 6px;
  }
  
  .ew-subtitle {
    font-size: 14px;
    margin-bottom: 20px;
  }
  
  .ew-top-numbers {
    margin-bottom: 15px;
  }
  
  .ew-number-1,
  .ew-number-2 {
    font-size: 20px;
  }
  
  .ew-arrows {
    margin-top: 12px;
    padding: 0 5px;
    gap: 10px;
  }
  
  .ew-arrow {
    width: 20px;
    height: 20px;
  }
  
  .ew-block {
    padding: 10px;
    padding-top: 120%;
  }
  
  .ew-block-button {
    padding: 5px 25px;
    font-size: 12px;
  }
}
</style>
