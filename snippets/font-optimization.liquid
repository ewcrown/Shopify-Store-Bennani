{%- comment -%}
Font Loading Optimization Snippet
This snippet provides optimized font loading with fallbacks and performance best practices
{%- endcomment -%}

<style>
  /* Font loading optimization - Using Google Fonts CSS2 API */
  @import url('https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap');

  /* Font loading states */
  .font-loading {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }

  .font-loaded {
    font-family: var(--josefin-sans-family);
  }

  /* Prevent layout shift during font loading */
  .ew-main-title,
  .ew-subtitle,
  .ew-block-button {
    font-display: swap;
  }

  /* Critical font preloading for above-the-fold content */
  .critical-font {
    font-family: var(--josefin-sans-family);
    font-display: swap;
  }
</style>

<script>
  // Font loading optimization script
  document.addEventListener('DOMContentLoaded', function() {
    // Check if Josefin Sans is loaded
    if ('fonts' in document) {
      document.fonts.ready.then(function() {
        document.documentElement.classList.add('fonts-loaded');
        console.log('Josefin Sans fonts loaded successfully');
      });

      // Check if specific font weights are available
      const checkFontWeight = async (weight) => {
        try {
          const font = new FontFace('Josefin Sans', `url(https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@${weight})`, {
            weight: weight,
            display: 'swap'
          });
          await font.load();
          document.fonts.add(font);
          console.log(`Josefin Sans ${weight} weight loaded`);
        } catch (error) {
          console.warn(`Failed to load Josefin Sans ${weight} weight:`, error);
        }
      };

      // Load critical font weights
      const criticalWeights = [400, 600, 700];
      criticalWeights.forEach(weight => {
        checkFontWeight(weight);
      });
    }
  });
</script>
